# Copy to `.env` and fill in real values. Never commit the actual `.env`.
# Values shown are the defaults / examples used by the code.

# ── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/auth

# ── Redis (rate limiting) ───────────────────────────────────────────────────
# Defaults if unset: localhost:6379. If Redis is unavailable the service still
# starts and rate limiting is skipped (fails open).
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT / session ───────────────────────────────────────────────────────────
# Lifetime for issued tokens. Accepts any jsonwebtoken duration string
# (e.g. 15m, 1h, 7d). Default: 1h.
JWT_EXPIRES_IN=1h

# Secret used to sign the session cookie. REQUIRED in production (leave unset
# only for local dev/tests). Use a long random string.
COOKIE_SECRET=change-me-to-a-long-random-string

# ── Deployment ──────────────────────────────────────────────────────────────
# Node environment (drives the cookie `secure` flag, on unless "test").
NODE_ENV=development

# Number of reverse-proxy hops to trust for req.ip. Set to 1 when behind a
# single proxy (nginx/ALB). Leave UNSET when the app talks to clients
# directly — trusting every hop lets clients spoof req.ip and evade rate
# limiting.
# TRUST_PROXY=1
