{
  "compilerOptions": {
    /* The app runs as native ESM via Node's type stripping (node src/index.ts),
       so module settings must match Node's ESM resolution. */
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],

    /* ESM hygiene: type-only imports must use `import type` (enforced at
       runtime by Node's strip-only mode anyway). */
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "types": ["jest", "node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
